{
  "manifest_version": 3,
  "name": "Scopos",
  "version": "0.2.0",
  "description": "AI-гид внутри любого веб-приложения: спросите, как что-то сделать, и Scopos покажет каждый шаг прямо на экране.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Открыть Scopos", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "side_panel": { "default_path": "sidepanel/sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "scripting", "tabs", "alarms", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*", "file:///*"],
    "js": ["core/scan.js", "core/pointer.js", "core/guide.js", "core/guard.js", "core/explore.js", "content.js"],
    "run_at": "document_idle"
  }],
  "commands": {
    "open-scopos": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Открыть Scopos" }
  }
}
