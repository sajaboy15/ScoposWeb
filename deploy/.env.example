# Copy to deploy/.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=sk-ant-...
# Where your app runs (the pages that embed Scopos), comma-separated
SCOPOS_ORIGINS=https://app.example.com
SCOPOS_MONTHLY_USD=5
PORT=4173
# 1 if your nginx/caddy/load balancer is in front of the container
SCOPOS_TRUST_PROXY=1
# Optional: learn mode on staging (also give it to the widget as data-learn-token, staging only)
SCOPOS_LEARN_TOKEN=
